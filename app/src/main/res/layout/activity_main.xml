<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_data_stream">

    <eightbitlab.com.blurview.BlurView
        android:id="@+id/banner_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="64dp"
        android:background="@drawable/bg_glass"
        android:clipToOutline="true"
        app:blurOverlayColor="#00000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/roi_container">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:padding="16dp"
            android:src="@drawable/lookaway_banner" />
    </eightbitlab.com.blurview.BlurView>

    <eightbitlab.com.blurview.BlurView
        android:id="@+id/roi_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/bg_glass"
        android:clipToOutline="true"
        app:blurOverlayColor="#00000000"
        app:layout_constraintTop_toBottomOf="@id/banner_container"
        app:layout_constraintBottom_toTopOf="@id/widget_control_blur">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scan Region"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"
                android:layout_gravity="center_horizontal"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/img_roi_multi"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_marginEnd="8dp"
                    android:padding="4dp"
                    android:background="@drawable/bg_roi_selector"
                    android:src="@drawable/roi_multi"
                    android:clickable="true"
                    android:focusable="true"/>

                <ImageView
                    android:id="@+id/img_roi_top"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_marginHorizontal="8dp"
                    android:padding="4dp"
                    android:background="@drawable/bg_roi_selector"
                    android:src="@drawable/roi_top"
                    android:clickable="true"
                    android:focusable="true"/>

                <ImageView
                    android:id="@+id/img_roi_bot"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_marginStart="8dp"
                    android:padding="4dp"
                    android:background="@drawable/bg_roi_selector"
                    android:src="@drawable/roi_bot"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <TextView
                android:id="@+id/roi_slider_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Margin Size: 20%"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_gravity="center_horizontal" />

            <SeekBar
                android:id="@+id/roi_seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="45"
                android:progress="15"
                android:progressTint="#00e5ff"
                android:thumbTint="#00e5ff" />
        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>

    <eightbitlab.com.blurview.BlurView
        android:id="@+id/widget_control_blur"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/bg_glass"
        android:clipToOutline="true"
        app:blurOverlayColor="#00000000"
        app:layout_constraintTop_toBottomOf="@id/roi_container"
        app:layout_constraintBottom_toTopOf="@id/targets_control_blur">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="4dp">

            <LinearLayout
                android:id="@+id/btn_toggle_overlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:paddingBottom="0dp">

                <ImageView
                    android:id="@+id/icon_power"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:src="@drawable/ic_power"
                    app:tint="#FFFFFF"/>

                <TextView
                    android:id="@+id/text_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ENABLE OVERLAY"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/instruction_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tap widget to begin scanning.\nShort press and hold widget to enter target acquisition mode.\nLong press and hold widget to reposition widget."
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="8dp"
                android:layout_marginHorizontal="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Widget Size"
                android:textColor="#DDDDDD"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="0dp"/>

            <SeekBar
                android:id="@+id/widget_size_seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="150"
                android:min="50"
                android:progress="100"
                android:progressTint="#00e5ff"
                android:thumbTint="#00e5ff"
                android:layout_marginBottom="4dp"/>
        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>

    <eightbitlab.com.blurview.BlurView
        android:id="@+id/targets_control_blur"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="60dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_glass"
        android:clipToOutline="true"
        app:blurOverlayColor="#00000000"
        app:layout_constraintTop_toBottomOf="@id/widget_control_blur"
        app:layout_constraintBottom_toTopOf="@id/tip_jar_blur">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="4dp">

            <LinearLayout
                android:id="@+id/btn_open_targets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:paddingBottom="0dp">

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:src="@drawable/ic_crosshair"
                    app:tint="#FFFFFF"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TARGETS"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/accuracy_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Target Match Required: 85%"
                android:textColor="#DDDDDD"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="0dp"/>

            <SeekBar
                android:id="@+id/accuracy_seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="95"
                android:min="60"
                android:progress="85"
                android:progressTint="#00e5ff"
                android:thumbTint="#00e5ff"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/accuracy_warning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CAUTION: Low percentages may result in false positives."
                android:textColor="#ff9100"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="4dp"
                android:textAlignment="center"/>
        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>

    <!-- NEW: Tip Jar Container -->
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/tip_jar_blur"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="48dp"
        android:background="@drawable/bg_glass"
        android:clipToOutline="true"
        app:blurOverlayColor="#00000000"
        app:layout_constraintTop_toBottomOf="@id/targets_control_blur"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp">

            <TextView
                android:id="@+id/text_ads_watched"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LookAway has watched 0 minutes of ads for you this week."
                android:textColor="#00e5ff"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:id="@+id/btn_kofi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#44FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="24dp"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☕ Support on Ko-fi"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="16sp"/>
            </LinearLayout>
        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>

</androidx.constraintlayout.widget.ConstraintLayout>