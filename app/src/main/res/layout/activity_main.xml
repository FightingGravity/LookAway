<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_data_stream">

    <eightbitlab.com.blurview.BlurView
        android:id="@+id/banner_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="64dp"
        android:background="@drawable/bg_glass"
        android:clipToOutline="true"
        app:blurOverlayColor="#00000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/widget_control_blur">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:padding="16dp"
            android:src="@drawable/lookaway_banner" />
    </eightbitlab.com.blurview.BlurView>

    <eightbitlab.com.blurview.BlurView
        android:id="@+id/widget_control_blur"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="60dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_glass"
        android:clipToOutline="true"
        app:blurOverlayColor="#00000000"
        app:layout_constraintTop_toBottomOf="@id/banner_container"
        app:layout_constraintBottom_toTopOf="@id/targets_control_blur">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="4dp">

            <LinearLayout
                android:id="@+id/btn_toggle_overlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:paddingVertical="16dp">

                <ImageView
                    android:id="@+id/icon_power"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_power"
                    app:tint="#FFFFFF"/>

                <TextView
                    android:id="@+id/text_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ENABLE OVERLAY"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/instruction_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tap widget to begin scanning.\nShort press widget for target acquisition.\nLong press to reposition widget."
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="8dp"
                android:layout_marginHorizontal="8dp" />

        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>

    <eightbitlab.com.blurview.BlurView
        android:id="@+id/targets_control_blur"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="60dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_glass"
        android:clipToOutline="true"
        app:blurOverlayColor="#00000000"
        app:layout_constraintTop_toBottomOf="@id/widget_control_blur"
        app:layout_constraintBottom_toTopOf="@id/settings_control_blur">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="4dp">

            <LinearLayout
                android:id="@+id/btn_open_targets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:paddingVertical="16dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_crosshair"
                    app:tint="#FFFFFF"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TARGETS"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>
        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>

    <eightbitlab.com.blurview.BlurView
        android:id="@+id/settings_control_blur"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="60dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_glass"
        android:clipToOutline="true"
        app:blurOverlayColor="#00000000"
        app:layout_constraintTop_toBottomOf="@id/targets_control_blur"
        app:layout_constraintBottom_toTopOf="@id/tip_jar_blur">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="4dp">

            <LinearLayout
                android:id="@+id/btn_open_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:paddingVertical="16dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_setting"
                    app:tint="#FFFFFF"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SETTINGS"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>
        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>

    <eightbitlab.com.blurview.BlurView
        android:id="@+id/tip_jar_blur"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="48dp"
        android:background="@drawable/bg_glass"
        android:clipToOutline="true"
        app:blurOverlayColor="#00000000"
        app:layout_constraintTop_toBottomOf="@id/settings_control_blur"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp">

            <TextView
                android:id="@+id/text_ads_watched"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LookAway has watched 0 minutes of ads for you this week."
                android:textColor="#00e5ff"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:id="@+id/btn_kofi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#44FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="24dp"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☕ Support on Ko-fi"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="16sp"/>
            </LinearLayout>
        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>

</androidx.constraintlayout.widget.ConstraintLayout>